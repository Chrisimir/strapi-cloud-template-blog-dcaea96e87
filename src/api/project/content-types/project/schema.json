{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "One piece of work. Drives /work, /work/[slug] and the homepage carousel."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "client": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "summary": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "coverAlt": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "film": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos", "files"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "filmUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "orientation": {
      "type": "enumeration",
      "enum": ["landscape", "portrait", "square"],
      "default": "landscape",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "stats": {
      "type": "component",
      "component": "project.stat",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "gallery": {
      "type": "component",
      "component": "project.media",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
